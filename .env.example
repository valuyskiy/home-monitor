# Copy this file to .env and replace every example value.
# Never commit .env or publish real tokens.

# Public IPv4 address of your router / internet gateway.
HOME_IP=203.0.113.10

# Home Assistant API endpoint. The URL must be reachable from the VPS.
HA_URL=https://home-assistant.example.com/api/config

# Telegram bot credentials:
# Create a bot with @BotFather and obtain your numeric chat ID.
TELEGRAM_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=123456789

# Long-lived access token from Home Assistant:
# Profile -> Security -> Long-Lived Access Tokens.
HA_TOKEN=REPLACE_WITH_HOME_ASSISTANT_TOKEN

# Polling interval, in seconds.
CHECK_INTERVAL=15

# Individual request timeouts, in seconds.
PING_TIMEOUT=3
HA_TIMEOUT=10
TELEGRAM_TIMEOUT=10

# Number of consecutive failed/successful checks before an alert/recovery.
FAIL_THRESHOLD=3
RECOVERY_THRESHOLD=2

# Daily Telegram heartbeat report.
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TIME=10:00

# IANA time zone, e.g. Europe/Moscow, Europe/Berlin, UTC.
TIMEZONE=Europe/Moscow
